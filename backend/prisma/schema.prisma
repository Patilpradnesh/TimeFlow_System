// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  password        String
  industry        Industry         @default(GENERAL)
  phoneNumber     String?
  avatarUrl       String?
  focusCredits    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tasks           Task[]
  notes           Note[]
  alarms          Alarm[]
  goals           Goal[]
  processes       Process[]
  trackers        Tracker[]
  flowGrid        FlowGrid?
  behaviorProfile BehaviorProfile?
  behaviorLogs    BehaviorLog[]
  behaviorEvents  BehaviorEvent[]
  executionSessions ExecutionSession[]
  focusCreditLogs FocusCredit[]
  privacyConsents PrivacyConsent[]
  jobApplications JobApplication[]
  resumeFiles     ResumeFile[]
}

model BehaviorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  avgResponseTime     Float?
  ignoreRate          Float?
  preferredActiveHour Int?
  totalTasksDone      Int      @default(0)
  totalReminders      Int      @default(0)
  updatedAt           DateTime @updatedAt
}

// Kept for backward compatibility, transitioning to BehaviorEvent
model BehaviorLog {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  taskId              String?
  task                Task?    @relation(fields: [taskId], references: [id])
  delayTimeSeconds    Int?     
  ignoreCount         Int      @default(0) 
  completionSpeed     Int?     
  behaviorTypeDetected String? 
  createdAt           DateTime @default(now())
}

model BehaviorEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      EventType
  metadata  Json?
  timestamp DateTime @default(now())
}

model ExecutionSession {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  taskId           String
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startTime        DateTime          @default(now())
  endTime          DateTime?
  notes            String?
  
  // Pivot Enhancements: Deep Behavioral Data
  plannedDuration  Int?              // in minutes
  actualDuration   Int?              // in minutes
  focusRating      Int?              // 1-10 self reported
  energyLevel      EnergyLevel?
  difficulty       DifficultyLevel?
  completionQuality Int?             // 1-10 self reported

  // New EIE Relations (preparing for EIE)
  progressUpdates  ProgressUpdate[]
  reflections      Reflection[]
  evidence         Evidence[]
  evidenceScore    EvidenceScore?
  evidenceEvents   EvidenceEvent[]
}

model Evidence {
  id               String            @id @default(cuid())
  sessionId        String
  session          ExecutionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  taskId           String
  type             EvidenceType      // Enum: PROGRESS, REFLECTION, ATTACHMENT
  content          String?           // Text content or description
  createdAt        DateTime          @default(now())
  attachments      EvidenceAttachment[]
}

model EvidenceAttachment {
  id               String            @id @default(cuid())
  evidenceId       String
  evidence         Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  fileUrl          String
  mimeType         String
  sizeBytes        Int
  createdAt        DateTime          @default(now())
}

model ProgressUpdate {
  id               String            @id @default(cuid())
  sessionId        String
  session          ExecutionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text             String
  completedPercent Int?
  createdAt        DateTime          @default(now())
}

model Reflection {
  id               String            @id @default(cuid())
  sessionId        String
  session          ExecutionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text             String
  emotionalState   String?
  createdAt        DateTime          @default(now())
}

model EvidenceScore {
  id               String            @id @default(cuid())
  sessionId        String            @unique
  session          ExecutionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  confidenceScore  Float             // 0.0 to 100.0
  aiAnalysis       Json              // Structured insights from the AI
  lastCalculatedAt DateTime          @default(now())
}

model EvidenceEvent {
  id               String            @id @default(cuid())
  sessionId        String
  session          ExecutionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType        String            // e.g., "UPLOAD_STARTED", "REFLECTION_SUBMITTED"
  timestamp        DateTime          @default(now())
}

model FocusCredit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  reason    String
  timestamp DateTime @default(now())
}

model PrivacyConsent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  version   String
  timestamp DateTime @default(now())
}

model AIInteraction {
  id          String   @id @default(cuid())
  type        AIType
  inputData   Json
  outputData  Json
  timestamp   DateTime @default(now())
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  progress    Int      @default(0)
  horizon     Horizon  @default(WEEKLY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  processes   Process[]
}

model Process {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  description String?
  templateId  String?  // If spawned from a Process Template
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
}

model Phase {
  id         String   @id @default(cuid())
  processId  String
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int
  tasks      Task[]
}

model Task {
  id            String      @id @default(cuid())
  title         String
  description   String?
  reason        String?     // The "Why" behind the task
  reasonForProcrastination ProcrastinationReason?
  emotionalTone String?     // AI-Ready: How the user feels
  status        TaskStatus  @default(TODO)
  priority      Priority    @default(MEDIUM)
  importance    Importance  @default(MEDIUM)
  urgencyScore  Float?
  dueDate       DateTime?
  completedAt   DateTime?
  isAlerted     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  phaseId       String?
  phase         Phase?      @relation(fields: [phaseId], references: [id])
  
  microSteps    MicroStep[]
  reminders     Reminder[]
  behaviorLogs  BehaviorLog[]
  behaviorEvents BehaviorEvent[]
  executionSessions ExecutionSession[]
}

model MicroStep {
  id          String     @id @default(cuid())
  taskId      String
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int        @default(0)
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Reminder {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  level       Int          // Escalation level: 1, 2, 3, 4
  scheduledAt DateTime
  sentAt      DateTime?
  isIgnored   Boolean      @default(false)
  message     String
  tone        ReminderTone
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   Json
  tags      String[]
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Alarm {
  id        String   @id @default(cuid())
  time      String   // e.g., "07:30"
  label     String?
  days      String[] // ["MON", "WED"]
  isActive  Boolean  @default(true)
  lastSentAt DateTime?

  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model FlowGrid {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  tasks     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tracker {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  columns     Json     @default("[]")
  rows        Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// JOB APPLICATION TRACKER (Student Placement Module)
// ═══════════════════════════════════════════════════════════════════
// Students apply to many companies in parallel and lose track of three
// things: which resume version they submitted, which stage each company
// is at, and what they must study next.
//
// This model is the single source of truth for all three. It also drives
// the real-time Kanban board (see socket events in src/lib/realtime.ts)
// and the application funnel analytics (GET /api/job-applications/stats).
model JobApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Core identity of the opportunity ---
  companyName String
  role        String
  packageCtc  String? // Free-form String on purpose: "12 LPA", "18 LPA + ESOP", "₹45k/month"
  jobLink     String? // Original posting URL

  // --- Pipeline state ---
  status          JobApplicationStatus @default(BOOKMARKED)
  statusUpdatedAt DateTime? // When the card last entered this stage (powering "stuck for N days")
  statusHistory   Json                 @default("[]") // Audit trail: [{ status, at }]

  // --- Tracking metadata ---
  applicationDate DateTime? // When it was actually submitted
  resumeUsed      String? // e.g. "resume_backend_v2.pdf" - kills the "which resume did I send?" panic
  resumeFileId    String? // The uploaded PDF/DOC/DOCX behind `resumeUsed` (see ResumeFile)
  resumeFile      ResumeFile? @relation(fields: [resumeFileId], references: [id], onDelete: SetNull)
  studyNotes      String? // Markdown: syllabus, company research, past interview questions

  // --- Prioritisation ---
  nextActionDate DateTime? // Next interview / deadline -> drives the 3-day alert badge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sorting a student's board is always "my jobs, by stage" or "my jobs, by next deadline"
  @@index([userId, status])
  @@index([userId, nextActionDate])
  @@index([userId, createdAt])
  @@index([resumeFileId])
}

/// A resume / CV the student actually uploaded (PDF, DOC or DOCX).
///
/// WHY THE BYTES LIVE IN POSTGRES: this project has no object-storage service
/// (no S3 bucket, no multer uploads directory), so the file is stored as
/// `bytea` right next to the row that references it. That keeps the feature
/// dependency-free, makes "back up the database" equal "back up every resume",
/// and means a download can never point at a file that a redeploy deleted.
///
/// The payload is accepted as base64 JSON (not multipart) because the server
/// already allows a 50 MB JSON body, which avoids adding a multipart parser.
/// Uploads are capped at MAX_RESUME_BYTES (8 MB) by the validator.
///
/// Downloads are streamed by GET /api/job-applications/resumes/:id, which
/// checks ownership before touching `data`.
model ResumeFile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Metadata (safe to select without pulling the blob) ---
  fileName String // Original name, e.g. "resume_backend_v2.pdf"
  mimeType String // application/pdf | application/msword | ...wordprocessingml.document
  fileSize Int // Bytes — denormalised so listings never touch `data`
  data     Bytes // The file itself

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobApplications JobApplication[]

  @@index([userId, createdAt])
}

enum Industry {
  TECH
  HEALTH
  BUSINESS
  SCHOOL
  COLLEGE
  CREATIVE
  FINANCE
  SPORTS
  GENERAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Importance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Horizon {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReminderTone {
  GENTLE
  ASSERTIVE
  URGENT
  CRITICAL
}

enum EventType {
  CREATED
  STARTED
  PAUSED
  IGNORED
  COMPLETED
}

enum ProcrastinationReason {
  OVERWHELMED
  FEAR_OF_FAILURE
  UNCLEAR_START
  LACK_OF_ENERGY
  WAITING_FOR_SOMEONE
  MISSING_INFORMATION
  TOO_DIFFICULT
  LOST_INTEREST
  PERSONAL_ISSUE
  HEALTH_ISSUE
  CHANGED_PRIORITY
  PERFECTIONISM
  DISTRACTED
  CUSTOM
  OTHER
}

enum EnergyLevel {
  HIGH
  MEDIUM
  LOW
  EXHAUSTED
}

enum DifficultyLevel {
  TRIVIAL
  EASY
  MODERATE
  HARD
  EXTREME
}

enum EvidenceType {
  PROGRESS
  REFLECTION
  ATTACHMENT
}

enum AIType {
  ROADMAP
  MICROSTEP
  REMINDER
  REFLECTION
  PROCESS
  RECOVERY
}

/// Ordered pipeline stages for the student placement tracker.
/// Declared in a deliberate order: index 0 = earliest, index 6 = offered.
/// The frontend mirrors this list in src/lib/jobTracker.ts.
enum JobApplicationStatus {
  BOOKMARKED
  APPLIED
  ONLINE_ASSESSMENT
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  OFFERED
  REJECTED
}
