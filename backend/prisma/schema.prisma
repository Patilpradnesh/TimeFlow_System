generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  industry          Industry           @default(GENERAL)
  phoneNumber       String?
  avatarUrl         String?
  focusCredits      Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  alarms            Alarm[]
  behaviorEvents    BehaviorEvent[]
  behaviorLogs      BehaviorLog[]
  behaviorProfile   BehaviorProfile?
  executionSessions ExecutionSession[]
  flowGrid          FlowGrid?
  focusCreditLogs   FocusCredit[]
  goals             Goal[]
  jobApplications   JobApplication[]
  notes             Note[]
  privacyConsents   PrivacyConsent[]
  processes         Process[]
  resumeFiles       ResumeFile[]
  tasks             Task[]
  trackers          Tracker[]
}

model BehaviorProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  avgResponseTime     Float?
  ignoreRate          Float?
  preferredActiveHour Int?
  totalTasksDone      Int      @default(0)
  totalReminders      Int      @default(0)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id])
}

model BehaviorLog {
  id                   String   @id @default(cuid())
  userId               String
  taskId               String?
  delayTimeSeconds     Int?
  ignoreCount          Int      @default(0)
  completionSpeed      Int?
  behaviorTypeDetected String?
  createdAt            DateTime @default(now())
  task                 Task?    @relation(fields: [taskId], references: [id])
  user                 User     @relation(fields: [userId], references: [id])
}

model BehaviorEvent {
  id        String    @id @default(cuid())
  userId    String
  taskId    String?
  type      EventType
  metadata  Json?
  timestamp DateTime  @default(now())
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

model ExecutionSession {
  id                String           @id @default(cuid())
  userId            String
  taskId            String
  startTime         DateTime         @default(now())
  endTime           DateTime?
  notes             String?
  plannedDuration   Int?
  actualDuration    Int?
  focusRating       Int?
  energyLevel       EnergyLevel?
  difficulty        DifficultyLevel?
  completionQuality Int?
  evidence          Evidence[]
  evidenceEvents    EvidenceEvent[]
  evidenceScore     EvidenceScore?
  task              Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id])
  progressUpdates   ProgressUpdate[]
  reflections       Reflection[]
}

model Evidence {
  id          String               @id @default(cuid())
  sessionId   String
  userId      String
  taskId      String
  type        EvidenceType
  content     String?
  createdAt   DateTime             @default(now())
  session     ExecutionSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments EvidenceAttachment[]
}

model EvidenceAttachment {
  id         String   @id @default(cuid())
  evidenceId String
  fileUrl    String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

model ProgressUpdate {
  id               String           @id @default(cuid())
  sessionId        String
  text             String
  completedPercent Int?
  createdAt        DateTime         @default(now())
  session          ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Reflection {
  id             String           @id @default(cuid())
  sessionId      String
  text           String
  emotionalState String?
  createdAt      DateTime         @default(now())
  session        ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EvidenceScore {
  id               String           @id @default(cuid())
  sessionId        String           @unique
  confidenceScore  Float
  aiAnalysis       Json
  lastCalculatedAt DateTime         @default(now())
  session          ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EvidenceEvent {
  id        String           @id @default(cuid())
  sessionId String
  eventType String
  timestamp DateTime         @default(now())
  session   ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model FocusCredit {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PrivacyConsent {
  id        String   @id @default(cuid())
  userId    String
  version   String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AIInteraction {
  id         String   @id @default(cuid())
  type       AIType
  inputData  Json
  outputData Json
  timestamp  DateTime @default(now())
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  progress    Int       @default(0)
  horizon     Horizon   @default(WEEKLY)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  processes   Process[]
}

model Process {
  id          String   @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  description String?
  templateId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  phases      Phase[]
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
}

model Phase {
  id         String  @id @default(cuid())
  processId  String
  title      String
  orderIndex Int
  process    Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  tasks      Task[]
}

model Task {
  id                       String                 @id @default(cuid())
  title                    String
  description              String?
  reason                   String?
  reasonForProcrastination ProcrastinationReason?
  emotionalTone            String?
  status                   TaskStatus             @default(TODO)
  priority                 Priority               @default(MEDIUM)
  importance               Importance             @default(MEDIUM)
  urgencyScore             Float?
  dueDate                  DateTime?
  completedAt              DateTime?
  isAlerted                Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  userId                   String
  phaseId                  String?
  behaviorEvents           BehaviorEvent[]
  behaviorLogs             BehaviorLog[]
  executionSessions        ExecutionSession[]
  microSteps               MicroStep[]
  reminders                Reminder[]
  phase                    Phase?                 @relation(fields: [phaseId], references: [id])
  user                     User                   @relation(fields: [userId], references: [id])
}

model MicroStep {
  id          String     @id @default(cuid())
  taskId      String
  title       String
  orderIndex  Int        @default(0)
  status      TaskStatus @default(TODO)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          String       @id @default(cuid())
  taskId      String
  level       Int
  scheduledAt DateTime
  sentAt      DateTime?
  isIgnored   Boolean      @default(false)
  message     String
  tone        ReminderTone
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   Json
  tags      String[]
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Alarm {
  id         String    @id @default(cuid())
  time       String
  label      String?
  days       String[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  userId     String
  lastSentAt DateTime?
  user       User      @relation(fields: [userId], references: [id])
}

model FlowGrid {
  id        String   @id @default(cuid())
  userId    String   @unique
  tasks     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Tracker {
  id        String   @id @default(cuid())
  userId    String
  name      String
  columns   Json     @default("[]")
  rows      Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model JobApplication {
  id              String               @id @default(cuid())
  userId          String
  companyName     String
  role            String
  packageCtc      String?
  jobLink         String?
  status          JobApplicationStatus @default(BOOKMARKED)
  statusUpdatedAt DateTime?
  statusHistory   Json                 @default("[]")
  applicationDate DateTime?
  resumeUsed      String?
  studyNotes      String?
  nextActionDate  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  resumeFileId    String?
  resumeFile      ResumeFile?          @relation(fields: [resumeFileId], references: [id])
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, nextActionDate])
  @@index([userId, createdAt])
  @@index([resumeFileId])
}

/// A resume / CV the student actually uploaded (PDF, DOC or DOCX).
///
/// WHY THE BYTES LIVE IN POSTGRES: this project has no object-storage service
/// (no S3 bucket, no multer uploads directory), so the file is stored as
/// `bytea` right next to the row that references it. That keeps the feature
/// dependency-free, makes "back up the database" equal "back up every resume",
/// and means a download can never point at a file that a redeploy deleted.
///
/// The payload is accepted as base64 JSON (not multipart) because the server
/// already allows a 50 MB JSON body, which avoids adding a multipart parser.
/// Uploads are capped at MAX_RESUME_BYTES (8 MB) by the validator.
///
/// Downloads are streamed by GET /api/job-applications/resumes/:id, which
/// checks ownership before touching `data`.
model ResumeFile {
  id              String           @id @default(cuid())
  userId          String
  fileName        String
  mimeType        String
  fileSize        Int
  data            Bytes
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobApplications JobApplication[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum Industry {
  TECH
  HEALTH
  BUSINESS
  SCHOOL
  COLLEGE
  CREATIVE
  FINANCE
  SPORTS
  GENERAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Importance {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Horizon {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReminderTone {
  GENTLE
  ASSERTIVE
  URGENT
  CRITICAL
}

enum EventType {
  CREATED
  STARTED
  PAUSED
  IGNORED
  COMPLETED
}

enum ProcrastinationReason {
  OVERWHELMED
  FEAR_OF_FAILURE
  UNCLEAR_START
  LACK_OF_ENERGY
  WAITING_FOR_SOMEONE
  MISSING_INFORMATION
  TOO_DIFFICULT
  LOST_INTEREST
  PERSONAL_ISSUE
  HEALTH_ISSUE
  CHANGED_PRIORITY
  PERFECTIONISM
  DISTRACTED
  CUSTOM
  OTHER
}

enum EnergyLevel {
  HIGH
  MEDIUM
  LOW
  EXHAUSTED
}

enum DifficultyLevel {
  TRIVIAL
  EASY
  MODERATE
  HARD
  EXTREME
}

enum EvidenceType {
  PROGRESS
  REFLECTION
  ATTACHMENT
}

enum AIType {
  ROADMAP
  MICROSTEP
  REMINDER
  REFLECTION
  PROCESS
  RECOVERY
}

/// Ordered pipeline stages for the student placement tracker.
/// Declared in a deliberate order: index 0 = earliest, index 6 = offered.
/// The frontend mirrors this list in src/lib/jobTracker.ts.
enum JobApplicationStatus {
  BOOKMARKED
  APPLIED
  ONLINE_ASSESSMENT
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  OFFERED
  REJECTED
}
